{
  "theme": "base",
  "themeVariables": {
    "fontFamily": "-apple-system, BlinkMacSystemFont, Segoe UI, Roboto, Helvetica Neue, Arial, sans-serif",
    "fontSize": "15px",
    "primaryColor": "#ffffff",
    "primaryTextColor": "#1c1b19",
    "primaryBorderColor": "#b8431f",
    "lineColor": "#615c55",
    "secondaryColor": "#fbe9e2",
    "tertiaryColor": "#f1eee8",
    "edgeLabelBackground": "#fbfaf7",
    "clusterBkg": "#f1eee8",
    "clusterBorder": "#e2ded6",
    "background": "transparent"
  },
  "flowchart": {
    "htmlLabels": false,
    "curve": "basis",
    "nodeSpacing": 36,
    "rankSpacing": 56,
    "padding": 12,
    "wrappingWidth": 230
  },
  "htmlLabels": false,
  "securityLevel": "strict"
}
